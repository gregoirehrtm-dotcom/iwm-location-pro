# Dépôt public : ne mettez jamais le vrai mot de passe ici.
# Copiez ce fichier en .env.local (ignoré par git) et renseignez-y le mot de passe.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=votre-mot-de-passe

# Envoi des demandes de devis par e-mail via Resend (facultatif, https://resend.com).
# Sans ces deux variables, les demandes sont seulement écrites dans les logs du serveur.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
# Expéditeur : laissez vide pour utiliser onboarding@resend.dev, ou indiquez une adresse
# d'un domaine vérifié dans Resend, par ex. IWM Location <devis@iwm-location.ch>
CONTACT_EMAIL_FROM=
